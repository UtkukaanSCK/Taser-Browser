{
  "manifest_version": 3,
  "name": "XB Selftest",
  "version": "1.0",
  "description": "Taser self-test extension: blocks /xb-ad.js, marks every page it runs in, and has a popup, a page for a frame in it with a mail link, and an options page.",
  "key": "",
  "permissions": ["declarativeNetRequest", "tabs"],
  "action": { "default_popup": "popup.html" },
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [{ "id": "xb", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["cs.js"], "all_frames": true, "run_at": "document_start" }
  ]
}
